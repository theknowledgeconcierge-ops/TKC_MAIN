# All values are SERVER-ONLY. No browser Supabase client/anon key is needed.
# Local: http://localhost:3000; Vercel: the exact HTTPS origin (no path).
APP_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The public key ID is returned safely by the checkout API; do not duplicate it.
# Use matched test credentials first, matched live credentials after the smoke test.
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=
# Set the same strong random value in the Razorpay webhook dashboard.
RAZORPAY_WEBHOOK_SECRET=
