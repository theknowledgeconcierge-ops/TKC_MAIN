# Server configuration; never expose credentials with NEXT_PUBLIC_*.
# No browser Supabase client/anon key is needed.
# Local: http://localhost:3000; production: the exact HTTPS origin (no path).
# Netlify previews use DEPLOY_PRIME_URL automatically; no extra operator values.
APP_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The public key ID is returned safely by the checkout API; do not duplicate it.
# Use matched test credentials first, matched live credentials after the smoke test.
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=
# Required for production/live keys; optional for local/test Netlify preview checkout.
# Webhooks remain disabled without it. Set the same strong value in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Post-purchase email delivery (optional: checkout and downloads never depend on it).
# Resend API key with sending access. Unset => delivery fails safely.
RESEND_API_KEY=
# Defaults to "Pixel n Palm <books@pixelnpalm.com>" once the domain is verified in Resend.
# Before verification, "Pixel n Palm <onboarding@resend.dev>" reaches only the Resend account owner.
EMAIL_FROM=
# At least 32 random characters (e.g. openssl rand -base64 48); authorizes the scheduled fallback.
EMAIL_DELIVERY_CRON_SECRET=
