# Local secrets/private staging must never be uploaded by the Vercel CLI.
.env*
*.env
.credentials
**/*.[pP][dD][fF]
private-pdfs/
*credentials*.json
*token.json*
*.key
*.pem
*.p12
*.pfx

# Install/build on Vercel from the lockfile, without local artifacts.
.git/
.next/
node_modules/
out/
dist/
coverage/
.cache/
.vercel/
*.tsbuildinfo
*.log
.DS_Store
*.tmp
*.bak
*.dump
*.sql.gz
*.patch
*.zip
*.tar
*.tar.gz
*.tgz
.idea/
.vscode/
supabase/.temp/
supabase/.branches/

# Operational/test documentation is not application runtime input.
tests/
test-results/
playwright-report/
docs/
