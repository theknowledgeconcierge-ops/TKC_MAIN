{
  "name": "the-knowledge-concierge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:assets",
    "build": "next build",
    "postbuild": "tsx scripts/check-public-assets.ts .next/static",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts next.config.ts",
    "test": "vitest run --exclude 'tests/database/**'",
    "test:db": "tsx scripts/test-database.ts",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "check:assets": "tsx scripts/check-public-assets.ts public",
    "storage:upload": "tsx scripts/upload-pdfs.ts",
    "order:recover": "tsx scripts/recover-order.ts",
    "check:integrations": "tsx scripts/check-integrations.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxlint": "1.76.0",
    "pg": "8.20.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
